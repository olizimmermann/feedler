# --- Core -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=feedler
WEB_PORT=8000
# Public base URL, used for links in the per-user RSS output feed
BASE_URL=http://localhost:8000

# --- LLM --------------------------------------------------------------------
# Default provider for new users: anthropic | openai | gemini | ollama
DEFAULT_LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_PROFILE_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROFILE_MODEL=

# Free tier available: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PROFILE_MODEL=gemini-3.8-flash

# Start the bundled Ollama with: docker compose --profile ollama up -d
# Models are downloaded automatically the first time they're needed.
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_PROFILE_MODEL=

# --- Reddit -----------------------------------------------------------------
# Optional but recommended. Create a "script" app at https://www.reddit.com/prefs/apps
# Without these, Feedler reads the public subreddit RSS feeds (no scores or comments).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=feedler/0.1 (self-hosted feed filter; contact: you@example.com)

# --- Tuning -----------------------------------------------------------------
DEFAULT_POLL_INTERVAL_MINUTES=15
ITEM_MAX_AGE_DAYS=3
PROFILE_REFINE_AFTER_VOTES=10
